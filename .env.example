# Copier ce fichier en .env dans server/ et remplir les valeurs

PORT=5001
NODE_ENV=development

# MongoDB Atlas — connection string depuis atlas.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/memoryMasterPro?retryWrites=true&w=majority

# JWT — une chaîne longue et aléatoire (ex: openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret

# URL du client (development)
CLIENT_URL=http://localhost:5173
